{
  "Description": "FAST Channels: the account's as-run router (shared as-run log)",
  "Parameters": {
    "BootstrapVersion": {
      "Default": "/cdk-bootstrap/hnb659fds/version",
      "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]",
      "Type": "AWS::SSM::Parameter::Value<String>"
    }
  },
  "Resources": {
    "RouterA91C40C5": {
      "DependsOn": [
        "RouterRoleDefaultPolicyFC745E62",
        "RouterRoleF1690116"
      ],
      "Properties": {
        "Architectures": [
          "arm64"
        ],
        "Code": {
          "S3Bucket": "cdk-hnb659fds-assets-123456789012-us-east-1",
          "S3Key": "<asset-hash>.zip"
        },
        "Description": "Put every Channel Assembly as-run event on the default event bus",
        "Environment": {
          "Variables": {
            "POWERTOOLS_METRICS_NAMESPACE": "FastChannels",
            "POWERTOOLS_SERVICE_NAME": "ops.as_run_router"
          }
        },
        "Handler": "fast_channels.functions.ops.as_run_router.handler",
        "LoggingConfig": {
          "ApplicationLogLevel": "INFO",
          "LogFormat": "JSON",
          "LogGroup": {
            "Ref": "RouterLogsFF27753A"
          },
          "SystemLogLevel": "INFO"
        },
        "MemorySize": 256,
        "RecursiveLoop": "Terminate",
        "Role": {
          "Fn::GetAtt": [
            "RouterRoleF1690116",
            "Arn"
          ]
        },
        "Runtime": "python3.14",
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ],
        "Timeout": 30,
        "TracingConfig": {
          "Mode": "Active"
        }
      },
      "Type": "AWS::Lambda::Function"
    },
    "RouterDeadLettersAlarm77EF0086": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ],
        "AlarmDescription": "As-run batches the router could not route after its retries; redrive them",
        "AlarmName": "fast-channels-as-run-router-dead-letters",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "RouterDeadLettersBB16E4F5",
                "QueueName"
              ]
            }
          }
        ],
        "EvaluationPeriods": 1,
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Namespace": "AWS/SQS",
        "OKActions": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ],
        "Period": 300,
        "Statistic": "Maximum",
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching"
      },
      "Type": "AWS::CloudWatch::Alarm"
    },
    "RouterDeadLettersBB16E4F5": {
      "DeletionPolicy": "Delete",
      "Properties": {
        "MessageRetentionPeriod": 1209600,
        "SqsManagedSseEnabled": true,
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ]
      },
      "Type": "AWS::SQS::Queue",
      "UpdateReplacePolicy": "Delete"
    },
    "RouterDeadLettersPolicy96E44602": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sqs:*",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              },
              "Effect": "Deny",
              "Principal": {
                "AWS": "*"
              },
              "Resource": {
                "Fn::GetAtt": [
                  "RouterDeadLettersBB16E4F5",
                  "Arn"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Queues": [
          {
            "Ref": "RouterDeadLettersBB16E4F5"
          }
        ]
      },
      "Type": "AWS::SQS::QueuePolicy"
    },
    "RouterErrorsAlarm42F08769": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ],
        "AlarmDescription": "The as-run router failed: stages reading the shared as-run log miss events until it succeeds (CloudWatch Logs retries it twice, then the dead-letter queue keeps the batch)",
        "AlarmName": "fast-channels-as-run-router-errors",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "RouterA91C40C5"
            }
          }
        ],
        "EvaluationPeriods": 1,
        "MetricName": "Errors",
        "Namespace": "AWS/Lambda",
        "OKActions": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ],
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching"
      },
      "Type": "AWS::CloudWatch::Alarm"
    },
    "RouterEventInvokeConfigB674FFEC": {
      "Properties": {
        "DestinationConfig": {
          "OnFailure": {
            "Destination": {
              "Fn::GetAtt": [
                "RouterDeadLettersBB16E4F5",
                "Arn"
              ]
            }
          }
        },
        "FunctionName": {
          "Ref": "RouterA91C40C5"
        },
        "MaximumEventAgeInSeconds": 21600,
        "MaximumRetryAttempts": 2,
        "Qualifier": "$LATEST"
      },
      "Type": "AWS::Lambda::EventInvokeConfig"
    },
    "RouterLogsFF27753A": {
      "DeletionPolicy": "Retain",
      "Properties": {
        "RetentionInDays": 7,
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ]
      },
      "Type": "AWS::Logs::LogGroup",
      "UpdateReplacePolicy": "Retain"
    },
    "RouterRoleDefaultPolicyFC745E62": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": [
                "logs:CreateLogStream",
                "logs:PutLogEvents"
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "RouterLogsFF27753A",
                  "Arn"
                ]
              }
            },
            {
              "Action": [
                "xray:PutTelemetryRecords",
                "xray:PutTraceSegments"
              ],
              "Effect": "Allow",
              "Resource": "*"
            },
            {
              "Action": "events:PutEvents",
              "Effect": "Allow",
              "Resource": "arn:aws:events:us-east-1:123456789012:event-bus/default"
            },
            {
              "Action": [
                "sqs:GetQueueAttributes",
                "sqs:GetQueueUrl",
                "sqs:SendMessage"
              ],
              "Effect": "Allow",
              "Resource": {
                "Fn::GetAtt": [
                  "RouterDeadLettersBB16E4F5",
                  "Arn"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "PolicyName": "RouterRoleDefaultPolicyFC745E62",
        "Roles": [
          {
            "Ref": "RouterRoleF1690116"
          }
        ]
      },
      "Type": "AWS::IAM::Policy"
    },
    "RouterRoleF1690116": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "RouterSubscription51D1AF28": {
      "DependsOn": [
        "RouterSubscriptionCanInvokeLambda39E0F0BE"
      ],
      "Properties": {
        "DestinationArn": {
          "Fn::GetAtt": [
            "RouterA91C40C5",
            "Arn"
          ]
        },
        "FilterName": "fast-channels-as-run-router",
        "FilterPattern": "",
        "LogGroupName": "MediaTailor/Channel/AsRunLog"
      },
      "Type": "AWS::Logs::SubscriptionFilter"
    },
    "RouterSubscriptionCanInvokeLambda39E0F0BE": {
      "Properties": {
        "Action": "lambda:InvokeFunction",
        "FunctionName": {
          "Fn::GetAtt": [
            "RouterA91C40C5",
            "Arn"
          ]
        },
        "Principal": "logs.amazonaws.com",
        "SourceArn": "arn:aws:logs:us-east-1:123456789012:log-group:MediaTailor/Channel/AsRunLog:*"
      },
      "Type": "AWS::Lambda::Permission"
    },
    "RouterThrottlesAlarmE100FE9F": {
      "Properties": {
        "AlarmActions": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ],
        "AlarmDescription": "The as-run router was throttled",
        "AlarmName": "fast-channels-as-run-router-throttles",
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Dimensions": [
          {
            "Name": "FunctionName",
            "Value": {
              "Ref": "RouterA91C40C5"
            }
          }
        ],
        "EvaluationPeriods": 1,
        "MetricName": "Throttles",
        "Namespace": "AWS/Lambda",
        "OKActions": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ],
        "Period": 300,
        "Statistic": "Sum",
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ],
        "Threshold": 1,
        "TreatMissingData": "notBreaching"
      },
      "Type": "AWS::CloudWatch::Alarm"
    },
    "RouterTopic16AD2D62": {
      "Properties": {
        "DisplayName": "FAST Channels alerts",
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fast"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ],
        "TopicName": "fast-channels-as-run-alerts"
      },
      "Type": "AWS::SNS::Topic"
    },
    "RouterTopicPolicy74EC5045": {
      "Properties": {
        "PolicyDocument": {
          "Statement": [
            {
              "Action": "sns:Publish",
              "Condition": {
                "Bool": {
                  "aws:SecureTransport": "false"
                }
              },
              "Effect": "Deny",
              "Principal": "*",
              "Resource": {
                "Ref": "RouterTopic16AD2D62"
              },
              "Sid": "AllowPublishThroughSSLOnly"
            }
          ],
          "Version": "2012-10-17"
        },
        "Topics": [
          {
            "Ref": "RouterTopic16AD2D62"
          }
        ]
      },
      "Type": "AWS::SNS::TopicPolicy"
    }
  },
  "Rules": {
    "CheckBootstrapVersion": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Contains": [
                  [
                    "1",
                    "2",
                    "3",
                    "4",
                    "5"
                  ],
                  {
                    "Ref": "BootstrapVersion"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
        }
      ]
    }
  }
}
