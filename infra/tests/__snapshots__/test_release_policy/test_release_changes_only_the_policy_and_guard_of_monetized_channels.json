{
  "guard_sibling_pattern": "fast-demo-p-?",
  "policy": {
    "Statement": [
      {
        "Action": "mediatailor:GetManifest",
        "Condition": {
          "ArnLike": {
            "aws:SourceArn": [
              "arn:aws:mediatailor:us-east-1:123456789012:playbackConfiguration/fast-demo",
              "arn:aws:mediatailor:us-east-1:123456789012:playbackConfiguration/fast-demo-p-?"
            ]
          },
          "StringEquals": {
            "aws:SourceAccount": "123456789012"
          }
        },
        "Effect": "Allow",
        "Principal": {
          "Service": "mediatailor.amazonaws.com"
        },
        "Resource": "arn:aws:mediatailor:us-east-1:123456789012:channel/fast-demo",
        "Sid": "AllowMediaTailorSsaiSigV4"
      }
    ],
    "Version": "2012-10-17"
  }
}
