ervice\", \"DesiredCount\": \"{% $max([$desired, $floor]) %}\"}, \"Retry\": [{\"ErrorEquals\": [\"States.ALL\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 3, \"BackoffRate\": 2}], \"End\": true}, \"WaitBeforeScaleIn\": {\"Type\": \"Wait\", \"Seconds\": 900, \"Next\": \"StillNoChannel\"}, \"StillNoChannel\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:ssm:getParameter\", \"Arguments\": {\"Name\": \"/fastm/ops/running-channels\"}, \"Assign\": {\"running\": \"{% $number($states.result.Parameter.Value) %}\"}, \"Retry\": [{\"ErrorEquals\": [\"States.ALL\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 3, \"BackoffRate\": 2}], \"Next\": \"NoneRunning\"}, \"NoneRunning\": {\"Type\": \"Choice\", \"Choices\": [{\"Condition\": \"{% $running = 0 %}\", \"Next\": \"LowerMinimum\"}], \"Default\": \"ChannelsBack\"}, \"ChannelsBack\": {\"Type\": \"Succeed\"}, \"LowerMinimum\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:applicationautoscaling:registerScalableTarget\", \"Arguments\": {\"ServiceNamespace\": \"ecs\", \"ResourceId\": \"service/fastm-pbs-PrebidCluster/fastm-pbs-Service\", \"ScalableDimension\": \"ecs:service:DesiredCount\", \"MinCapacity\": 0, \"MaxCapacity\": 4}, \"Retry\": [{\"ErrorEquals\": [\"States.ALL\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 3, \"BackoffRate\": 2}], \"Next\": \"ScaleIn\"}, \"ScaleIn\": {\"Type\": \"Task\", \"Resource\": \"arn:aws:states:::aws-sdk:ecs:updateService\", \"Arguments\": {\"Cluster\": \"fastm-pbs-PrebidCluster\", \"Service\": \"fastm-pbs-Service\", \"DesiredCount\": 0}, \"Retry\": [{\"ErrorEquals\": [\"States.ALL\"], \"IntervalSeconds\": 5, \"MaxAttempts\": 3, \"BackoffRate\": 2}], \"End\": true}}}",
