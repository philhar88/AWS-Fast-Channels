      "Properties": {
        "Artifacts": {
          "Type": "NO_ARTIFACTS"
        },
        "Cache": {
          "Type": "NO_CACHE"
        },
        "Description": "FAST Channels (fastm): synthetic probe auctions that warm new Prebid Server tasks",
        "EncryptionKey": "alias/aws/s3",
        "Environment": {
          "ComputeType": "BUILD_GENERAL1_SMALL",
          "Image": "aws/codebuild/amazonlinux-aarch64-standard:3.0",
          "ImagePullCredentialsType": "CODEBUILD",
          "PrivilegedMode": false,
          "Type": "ARM_CONTAINER"
        },
        "LogsConfig": {
          "CloudWatchLogs": {
            "GroupName": {
              "Ref": "WarmUpLogsF1D2B44C"
            },
            "Status": "ENABLED"
          }
        },
        "Name": "fastm-pbs-warmup",
        "ServiceRole": {
          "Fn::GetAtt": [
            "WarmUpProjectRole9583194A",
            "Arn"
          ]
        },
        "Source": {
          "BuildSpec": "{\n  \"version\": \"0.2\",\n  \"env\": {\n    \"shell\": \"bash\"\n  },\n  \"phases\": {\n    \"install\": {\n      \"commands\": [\n        \"curl -fsSL -o vegeta.tar.gz \\\"https://github.com/tsenart/vegeta/releases/download/v12.13.0/vegeta_12.13.0_linux_arm64.tar.gz\\\"\",\n        \"echo \\\"<asset-hash>  vegeta.tar.gz\\\" | sha256sum -c -\",\n        \"tar -xzf vegeta.tar.gz vegeta && ./vegeta -version\"\n      ]\n    },\n    \"pre_build\": {\n      \"commands\": [\n        \"if [ -n \\\"${TASK_ARN:-}\\\" ]; then IP=$(aws ecs describe-tasks --cluster arn:aws:ecs:us-east-1:123456789012:cluster/fastm-pbs-PrebidCluster --tasks \\\"$TASK_ARN\\\" --query \\\"tasks[0].attachments[0].details[?name=='privateIPv4Address'].value | [0]\\\" --output text); for i in $(seq 1 60); do STATE=$(aws elbv2 describe-target-health --target-group-arn arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/fastm-pbs/0123456789abcd --query \\\"TargetHealthDescriptions[?Target.Id=='$IP'].TargetHealth.State | [0]\\\" --output text); [ \\\"$STATE\\\" = healthy ] && break; [ \\\"$STATE\\\" = draining ] && { echo \\\"task $TASK_ARN is draining: no warm-up\\\"; SKIP=1; break; }; sleep 10; done; [ \\\"$STATE\\\" = healthy ] || [ \\\"${SKIP:-0}\\\" = 1 ] || { echo \\\"task $TASK_ARN ($IP) is $STATE after 600 s\\\"; exit 1; }; fi\",\n        \"HEALTHY=$(aws elbv2 describe-target-health --target-group-arn arn:aws:elasticloadbalancing:us-east-1:123456789012:targetgroup/fastm-pbs/0123456789abcd --query \\\"length(TargetHealthDescriptions[?TargetHealth.State=='healthy'])\\\" --output text)\",\n        \"RATE=${RATE:-$(( 50 * (HEALTHY > 0 ? HEALTHY : 1) ))}; echo \\\"replaying $RATE/s over $HEALTHY healthy targets\\\"\"\n      ]\n    },\n    \"build\": {\n      \"commands\": [\n        \"SECRET=$(aws secretsmanager get-secret-value --region us-east-1 --secret-id fastm/demand/origin-a --query SecretString --output text)\",\n        \"printf '%s' '{\\\"ext\\\":{\\\"prebid\\\":{\\\"storedrequest\\\":{\\\"id\\\":\\\"fast-pod-120s\\\"}}}}' > body.json\",\n        \"{ echo \\\"POST https://d111111abcdef8.cloudfront.net/openrtb2/auction?evid=1&upid=warmup&dur=120120\\\"; echo \\\"x-fast-origin: $SECRET\\\"; echo \\\"Content-Type: application/json\\\"; echo \\\"X-Fast-Probe: 1\\\"; echo \\\"X-Fast-Sid: warmup-$CODEBUILD_BUILD_NUMBER\\\"; echo \\\"X-Fast-Pc: fastm-warmup\\\"; echo \\\"@body.json\\\"; } > targets.txt\",\n        \"if [ \\\"${SKIP:-0}\\\" != 1 ]; then ./vegeta attack -targets=targets.txt -rate=${RATE}/s -duration=${SECONDS_TO_RUN:-150}s -timeout=5s > results.bin && ./vegeta report results.bin && echo \\\"VEGETA_JSON $(./vegeta report -type=json results.bin)\\\"; fi\"\n      ]\n    }\n  }\n}",
          "Type": "NO_SOURCE"
        },
        "Tags": [
          {
            "Key": "fast:app",
            "Value": "fastm"
          },
          {
            "Key": "fast:module",
            "Value": "demand"
          },
          {
            "Key": "fast:owner",
            "Value": "iac"
          }
        ],
        "TimeoutInMinutes": 20
      },
      "Type": "AWS::CodeBuild::Project"
    },
