{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AssetKind": {
      "enum": [
        "content",
        "slate",
        "ad"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "GeneratorInput": {
      "additionalProperties": false,
      "description": "A still-image input (slate or house ad) rendered for exactly ``duration_gops`` GOPs of the ladder.",
      "properties": {
        "image_s3_uri": {
          "pattern": "^s3://[^/]+/.+\\.(png|PNG|tga|TGA|bmp|BMP)$",
          "title": "Image S3 Uri",
          "type": "string"
        },
        "duration_gops": {
          "maximum": 43200,
          "minimum": 1,
          "title": "Duration Gops",
          "type": "integer"
        },
        "label": {
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "image_s3_uri",
        "duration_gops",
        "label"
      ],
      "title": "GeneratorInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Encode one source (a file, or a still image for slates and house ads) with one ladder.\n\nExactly one of ``source_uri`` and ``generator`` is set. ``correlation_id`` becomes the execution name.",
  "properties": {
    "source_uri": {
      "anyOf": [
        {
          "maxLength": 2048,
          "pattern": "^(s3|https)://\\S+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mezzanine file (s3:// or https://).",
      "title": "Source Uri"
    },
    "generator": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeneratorInput"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Still image rendered for a whole number of GOPs."
    },
    "kind": {
      "$ref": "#/$defs/AssetKind",
      "default": "content"
    },
    "asset_id": {
      "anyOf": [
        {
          "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Defaults to asset_id_for(source).",
      "title": "Asset Id"
    },
    "content_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Catalog content id.",
      "title": "Content Id"
    },
    "cue_points_ms": {
      "default": [],
      "description": "Editorial ad cue points (ms); snapped to the segment grid.",
      "items": {
        "type": "integer"
      },
      "title": "Cue Points Ms",
      "type": "array"
    },
    "ladder_version": {
      "description": "Ladder version, e.g. standard@0123abcd45.",
      "pattern": "^[a-z][a-z0-9-]*@[0-9a-f]{10}$",
      "title": "Ladder Version",
      "type": "string"
    },
    "correlation_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9_-]{1,80}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Trace id; Step Functions execution name.",
      "title": "Correlation Id"
    },
    "metadata": {
      "additionalProperties": {
        "type": "string"
      },
      "default": {},
      "title": "Metadata",
      "type": "object"
    }
  },
  "required": [
    "ladder_version"
  ],
  "title": "IngestRequest",
  "type": "object"
}
