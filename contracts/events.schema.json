{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAST Channels events",
  "description": "EventBridge events on the fast-channels bus; source is fast-channels.<prefix>.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ingest Requested"
        },
        "detail": {
          "$ref": "#/$defs/IngestRequest"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Asset Ready"
        },
        "detail": {
          "$ref": "#/$defs/AssetReady"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Asset Failed"
        },
        "detail": {
          "$ref": "#/$defs/AssetFailed"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ladder Ready"
        },
        "detail": {
          "$ref": "#/$defs/LadderReady"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ladder Failed"
        },
        "detail": {
          "$ref": "#/$defs/LadderFailed"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Schedule Published"
        },
        "detail": {
          "$ref": "#/$defs/SchedulePublished"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Autopilot Run"
        },
        "detail": {
          "$ref": "#/$defs/AutopilotRun"
        }
      }
    }
  ],
  "$defs": {
    "AssetFailed": {
      "description": "An ingest execution failed.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "ladder_version",
        "error",
        "cause",
        "correlation_id"
      ],
      "title": "AssetFailed",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "content",
        "slate",
        "ad"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetReady": {
      "description": "An asset is encoded, verified and (for content and slates) registered as a VOD source.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "vod_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Channel Assembly VOD source name; null for ads.",
          "title": "Vod Source"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "captions": {
          "default": [],
          "description": "Where each caption track came from, in ladder order.",
          "items": {
            "$ref": "#/$defs/CaptionProvenance"
          },
          "title": "Captions",
          "type": "array"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "ladder_version",
        "vod_source",
        "duration_ms",
        "correlation_id"
      ],
      "title": "AssetReady",
      "type": "object"
    },
    "AutopilotRun": {
      "description": "An autopilot run finished.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "status",
        "session_id",
        "summary"
      ],
      "title": "AutopilotRun",
      "type": "object"
    },
    "CaptionFile": {
      "additionalProperties": false,
      "description": "A caption file provided with a source, for one language.",
      "properties": {
        "uri": {
          "description": "s3:// or https:// URI, or a key relative to the source file's folder (movie.en.scc).",
          "maxLength": 2048,
          "minLength": 1,
          "title": "Uri",
          "type": "string"
        },
        "language": {
          "description": "BCP-47 language of the captions, e.g. en.",
          "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
          "title": "Language",
          "type": "string"
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionFormat"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to the format the file extension implies."
        },
        "offset_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Shift added to every cue time (negative is earlier). Defaults to 0, and for SCC files to minus the hour (or source timecode) they were authored from, e.g. -3600000 for 01:00:00;00.",
          "title": "Offset Ms"
        },
        "frame_rate": {
          "anyOf": [
            {
              "$ref": "#/$defs/FrameRate"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Timecode rate of an SCC file; MediaConvert's default."
        }
      },
      "required": [
        "uri",
        "language"
      ],
      "title": "CaptionFile",
      "type": "object"
    },
    "CaptionFormat": {
      "description": "Sidecar caption formats MediaConvert reads (``SourceType``).",
      "enum": [
        "scc",
        "srt",
        "webvtt",
        "ttml",
        "smpte-tt",
        "imsc",
        "stl",
        "smi"
      ],
      "title": "CaptionFormat",
      "type": "string"
    },
    "CaptionMode": {
      "description": "How an ingest finds captions: ``auto`` uses provided files, then captions in the source, then generates;\n``generate`` ignores captions in the source; ``off`` writes empty tracks.",
      "enum": [
        "auto",
        "generate",
        "off"
      ],
      "title": "CaptionMode",
      "type": "string"
    },
    "CaptionOrigin": {
      "enum": [
        "provided",
        "embedded",
        "generated",
        "none"
      ],
      "title": "CaptionOrigin",
      "type": "string"
    },
    "CaptionProvenance": {
      "description": "Where an encoded caption track came from: asset items, ``Asset Ready`` and the agent's asset details.",
      "properties": {
        "language": {
          "title": "Language",
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/CaptionOrigin"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The file the track was encoded from (provided or generated).",
          "title": "Uri"
        },
        "engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The captioner engine, for generated captions.",
          "title": "Engine"
        }
      },
      "required": [
        "language",
        "origin"
      ],
      "title": "CaptionProvenance",
      "type": "object"
    },
    "CaptionsRequest": {
      "additionalProperties": false,
      "description": "The captions part of an ingest request.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/CaptionMode",
          "default": "auto"
        },
        "files": {
          "default": [],
          "description": "Provided caption files, at most one per language.",
          "items": {
            "$ref": "#/$defs/CaptionFile"
          },
          "title": "Files",
          "type": "array"
        },
        "spoken_language": {
          "anyOf": [
            {
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Language of the main audio: what embedded and generated captions are in. Defaults to the language of the source's first audio track, then the ladder's first caption track.",
          "title": "Spoken Language"
        }
      },
      "title": "CaptionsRequest",
      "type": "object"
    },
    "FrameRate": {
      "additionalProperties": false,
      "description": "Exact frame rate as a fraction; accepts ``\"29.97\"``, ``\"30000/1001\"``, ``25`` or ``29.97`` on input.",
      "properties": {
        "numerator": {
          "exclusiveMinimum": 0,
          "title": "Numerator",
          "type": "integer"
        },
        "denominator": {
          "exclusiveMinimum": 0,
          "title": "Denominator",
          "type": "integer"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "title": "FrameRate",
      "type": "object"
    },
    "GeneratorInput": {
      "additionalProperties": false,
      "description": "A still-image input (slate or house ad) rendered for exactly ``duration_gops`` GOPs of the ladder.",
      "properties": {
        "image_s3_uri": {
          "pattern": "^s3://[^/]+/.+\\.(png|PNG|tga|TGA|bmp|BMP)$",
          "title": "Image S3 Uri",
          "type": "string"
        },
        "duration_gops": {
          "maximum": 43200,
          "minimum": 1,
          "title": "Duration Gops",
          "type": "integer"
        },
        "label": {
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "image_s3_uri",
        "duration_gops",
        "label"
      ],
      "title": "GeneratorInput",
      "type": "object"
    },
    "IngestRequest": {
      "additionalProperties": false,
      "description": "Encode one source (a file, or a still image for slates and house ads) with one ladder.\n\nExactly one of ``source_uri`` and ``generator`` is set. ``correlation_id`` becomes the execution name.",
      "properties": {
        "source_uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^(s3|https)://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mezzanine file (s3:// or https://).",
          "title": "Source Uri"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Still image rendered for a whole number of GOPs."
        },
        "kind": {
          "$ref": "#/$defs/AssetKind",
          "default": "content"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to asset_id_for(source).",
          "title": "Asset Id"
        },
        "content_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Catalog content id.",
          "title": "Content Id"
        },
        "cue_points_ms": {
          "default": [],
          "description": "Editorial ad cue points (ms); snapped to the GOP grid.",
          "items": {
            "type": "integer"
          },
          "title": "Cue Points Ms",
          "type": "array"
        },
        "captions": {
          "anyOf": [
            {
              "$ref": "#/$defs/CaptionsRequest"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Provided caption files and how to find or generate the rest (default: auto)."
        },
        "ladder_version": {
          "description": "Ladder version, e.g. standard@0123abcd45.",
          "pattern": "^[a-z][a-z0-9-]*@[0-9a-f]{10}$",
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trace id; Step Functions execution name.",
          "title": "Correlation Id"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "ladder_version"
      ],
      "title": "IngestRequest",
      "type": "object"
    },
    "LadderFailed": {
      "description": "Provisioning a ladder failed.",
      "properties": {
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        }
      },
      "required": [
        "ladder_version",
        "correlation_id",
        "error",
        "cause"
      ],
      "title": "LadderFailed",
      "type": "object"
    },
    "LadderReady": {
      "description": "A ladder's job template and kit (filler, break slates, house ads, VAST) are ready.",
      "properties": {
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "job_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MediaConvert job template name.",
          "title": "Job Template"
        }
      },
      "required": [
        "ladder_version",
        "correlation_id"
      ],
      "title": "LadderReady",
      "type": "object"
    },
    "SchedulePublished": {
      "description": "A plan was published to a channel.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "programs": {
          "title": "Programs",
          "type": "integer"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "title": "End Ms",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "plan_id",
        "programs",
        "start_ms",
        "end_ms",
        "correlation_id"
      ],
      "title": "SchedulePublished",
      "type": "object"
    }
  }
}
