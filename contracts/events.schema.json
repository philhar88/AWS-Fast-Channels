{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAST Channels events",
  "description": "EventBridge events on the fast-channels bus; source is fast-channels.<prefix>.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ingest Requested"
        },
        "detail": {
          "$ref": "#/$defs/IngestRequest"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Asset Ready"
        },
        "detail": {
          "$ref": "#/$defs/AssetReady"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Asset Failed"
        },
        "detail": {
          "$ref": "#/$defs/AssetFailed"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ladder Ready"
        },
        "detail": {
          "$ref": "#/$defs/LadderReady"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ladder Failed"
        },
        "detail": {
          "$ref": "#/$defs/LadderFailed"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Schedule Published"
        },
        "detail": {
          "$ref": "#/$defs/SchedulePublished"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Autopilot Run"
        },
        "detail": {
          "$ref": "#/$defs/AutopilotRun"
        }
      }
    }
  ],
  "$defs": {
    "AssetFailed": {
      "description": "An ingest execution failed.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "ladder_version",
        "error",
        "cause",
        "correlation_id"
      ],
      "title": "AssetFailed",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "content",
        "slate",
        "ad"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetReady": {
      "description": "An asset is encoded, verified and (for content and slates) registered as a VOD source.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "vod_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Channel Assembly VOD source name; null for ads.",
          "title": "Vod Source"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "ladder_version",
        "vod_source",
        "duration_ms",
        "correlation_id"
      ],
      "title": "AssetReady",
      "type": "object"
    },
    "AutopilotRun": {
      "description": "An autopilot run finished.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "status",
        "session_id",
        "summary"
      ],
      "title": "AutopilotRun",
      "type": "object"
    },
    "GeneratorInput": {
      "additionalProperties": false,
      "description": "A still-image input (slate or house ad) rendered for exactly ``duration_gops`` GOPs of the ladder.",
      "properties": {
        "image_s3_uri": {
          "pattern": "^s3://[^/]+/.+\\.(png|PNG|tga|TGA|bmp|BMP)$",
          "title": "Image S3 Uri",
          "type": "string"
        },
        "duration_gops": {
          "maximum": 43200,
          "minimum": 1,
          "title": "Duration Gops",
          "type": "integer"
        },
        "label": {
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "image_s3_uri",
        "duration_gops",
        "label"
      ],
      "title": "GeneratorInput",
      "type": "object"
    },
    "IngestRequest": {
      "additionalProperties": false,
      "description": "Encode one source (a file, or a still image for slates and house ads) with one ladder.\n\nExactly one of ``source_uri`` and ``generator`` is set. ``correlation_id`` becomes the execution name.",
      "properties": {
        "source_uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^(s3|https)://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mezzanine file (s3:// or https://).",
          "title": "Source Uri"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Still image rendered for a whole number of GOPs."
        },
        "kind": {
          "$ref": "#/$defs/AssetKind",
          "default": "content"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to asset_id_for(source).",
          "title": "Asset Id"
        },
        "content_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Catalog content id.",
          "title": "Content Id"
        },
        "cue_points_ms": {
          "default": [],
          "description": "Editorial ad cue points (ms); snapped to the segment grid.",
          "items": {
            "type": "integer"
          },
          "title": "Cue Points Ms",
          "type": "array"
        },
        "ladder_version": {
          "description": "Ladder version, e.g. standard@0123abcd45.",
          "pattern": "^[a-z][a-z0-9-]*@[0-9a-f]{10}$",
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trace id; Step Functions execution name.",
          "title": "Correlation Id"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "ladder_version"
      ],
      "title": "IngestRequest",
      "type": "object"
    },
    "LadderFailed": {
      "description": "Provisioning a ladder failed.",
      "properties": {
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        }
      },
      "required": [
        "ladder_version",
        "correlation_id",
        "error",
        "cause"
      ],
      "title": "LadderFailed",
      "type": "object"
    },
    "LadderReady": {
      "description": "A ladder's job template and kit (filler, break slates, house ads, VAST) are ready.",
      "properties": {
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "job_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MediaConvert job template name.",
          "title": "Job Template"
        }
      },
      "required": [
        "ladder_version",
        "correlation_id"
      ],
      "title": "LadderReady",
      "type": "object"
    },
    "SchedulePublished": {
      "description": "A plan was published to a channel.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "programs": {
          "title": "Programs",
          "type": "integer"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "title": "End Ms",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "plan_id",
        "programs",
        "start_ms",
        "end_ms",
        "correlation_id"
      ],
      "title": "SchedulePublished",
      "type": "object"
    }
  }
}
