{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FAST Channels events",
  "description": "EventBridge events on the fast-channels bus; source is fast-channels.<prefix>.",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ingest Requested"
        },
        "detail": {
          "$ref": "#/$defs/IngestRequest"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Asset Ready"
        },
        "detail": {
          "$ref": "#/$defs/AssetReady"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Asset Failed"
        },
        "detail": {
          "$ref": "#/$defs/AssetFailed"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ladder Ready"
        },
        "detail": {
          "$ref": "#/$defs/LadderReady"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Ladder Failed"
        },
        "detail": {
          "$ref": "#/$defs/LadderFailed"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Schedule Published"
        },
        "detail": {
          "$ref": "#/$defs/SchedulePublished"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Autopilot Run"
        },
        "detail": {
          "$ref": "#/$defs/AutopilotRun"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Catalog Item Changed"
        },
        "detail": {
          "$ref": "#/$defs/CatalogItemChanged"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Census Changed"
        },
        "detail": {
          "$ref": "#/$defs/CensusChanged"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Channel Alert"
        },
        "detail": {
          "$ref": "#/$defs/ChannelAlert"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "source",
        "detail-type",
        "detail"
      ],
      "properties": {
        "source": {
          "type": "string",
          "pattern": "^fast-channels\\..+$"
        },
        "detail-type": {
          "const": "Desired State Rendered"
        },
        "detail": {
          "$ref": "#/$defs/DesiredStateRendered"
        }
      }
    }
  ],
  "$defs": {
    "AssetFailed": {
      "description": "An ingest execution failed.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "ladder_version",
        "error",
        "cause",
        "correlation_id"
      ],
      "title": "AssetFailed",
      "type": "object"
    },
    "AssetKind": {
      "enum": [
        "content",
        "slate",
        "ad"
      ],
      "title": "AssetKind",
      "type": "string"
    },
    "AssetReady": {
      "description": "An asset is encoded, verified and (for content and slates) registered as a VOD source.",
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AssetKind"
        },
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "vod_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Channel Assembly VOD source name; null for ads.",
          "title": "Vod Source"
        },
        "duration_ms": {
          "title": "Duration Ms",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "asset_id",
        "kind",
        "ladder_version",
        "vod_source",
        "duration_ms",
        "correlation_id"
      ],
      "title": "AssetReady",
      "type": "object"
    },
    "AutopilotRun": {
      "description": "An autopilot run finished.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "status": {
          "enum": [
            "SUCCEEDED",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "status",
        "session_id",
        "summary"
      ],
      "title": "AutopilotRun",
      "type": "object"
    },
    "CatalogItemChanged": {
      "description": "A title of the reference catalog was added, changed or removed. A CMS sync job puts this event after writing\nthe ``ReferenceCatalog`` item; the content enrichment module republishes the title's catalog context object.",
      "properties": {
        "content_id": {
          "description": "The title's catalog id.",
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "title": "Content Id",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trace id of the change in your CMS.",
          "title": "Correlation Id"
        }
      },
      "required": [
        "content_id"
      ],
      "title": "CatalogItemChanged",
      "type": "object"
    },
    "CensusChanged": {
      "description": "The number of the deployment's running channels crossed zero: the first channel started, or the last one\nstopped (published by the channel census with the ops module on; at most one census interval late).",
      "properties": {
        "running": {
          "description": "Running channels now; 0 when the last one stopped.",
          "minimum": 0,
          "title": "Running",
          "type": "integer"
        },
        "previous": {
          "description": "Running channels at the census before.",
          "minimum": 0,
          "title": "Previous",
          "type": "integer"
        },
        "correlation_id": {
          "description": "Name of the census execution that saw the change.",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "running",
        "previous",
        "correlation_id"
      ],
      "title": "CensusChanged",
      "type": "object"
    },
    "ChannelAlert": {
      "description": "A Channel Assembly alert of a running channel changed (ops module): Channel Assembly and MediaTailor publish no\nevents, so a poller reads ``ListAlerts`` every minute and publishes each alert changed in that minute once.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "code": {
          "description": "Alert code; for PROGRAM_ALERT the message names the program and its alert.",
          "title": "Code",
          "type": "string"
        },
        "category": {
          "description": "SCHEDULING_ERROR (breaks playback), PLAYBACK_WARNING or INFO.",
          "title": "Category",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "resource_arn": {
          "title": "Resource Arn",
          "type": "string"
        },
        "last_modified": {
          "description": "UTC ISO-8601 time of the alert's last change.",
          "title": "Last Modified",
          "type": "string"
        },
        "correlation_id": {
          "description": "The poll's scheduled time, which every alert of one poll shares.",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "code",
        "category",
        "message",
        "resource_arn",
        "last_modified",
        "correlation_id"
      ],
      "title": "ChannelAlert",
      "type": "object"
    },
    "DesiredStateRendered": {
      "description": "A deployment rendered a new release bundle (release module): the stack wrote it to the release bucket, and the\nRelease Controller validates and applies it to each monetized channel's idle sibling.",
      "properties": {
        "bundle_key": {
          "description": "S3 key of the bundle document, release/<digest>/bundle.json.",
          "title": "Bundle Key",
          "type": "string"
        },
        "digest": {
          "description": "SHA-256 of the bundle: its version.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Digest",
          "type": "string"
        },
        "correlation_id": {
          "description": "The CloudFormation request that rendered it.",
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "bundle_key",
        "digest",
        "correlation_id"
      ],
      "title": "DesiredStateRendered",
      "type": "object"
    },
    "GeneratorInput": {
      "additionalProperties": false,
      "description": "A still-image input (slate or house ad) rendered for exactly ``duration_gops`` GOPs of the ladder.",
      "properties": {
        "image_s3_uri": {
          "pattern": "^s3://[^/]+/.+\\.(png|PNG|tga|TGA|bmp|BMP)$",
          "title": "Image S3 Uri",
          "type": "string"
        },
        "duration_gops": {
          "maximum": 43200,
          "minimum": 1,
          "title": "Duration Gops",
          "type": "integer"
        },
        "label": {
          "maxLength": 48,
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "image_s3_uri",
        "duration_gops",
        "label"
      ],
      "title": "GeneratorInput",
      "type": "object"
    },
    "IngestRequest": {
      "additionalProperties": false,
      "description": "Encode one source (a file, or a still image for slates and house ads) with one ladder.\n\nExactly one of ``source_uri`` and ``generator`` is set. ``correlation_id`` becomes the execution name.",
      "properties": {
        "source_uri": {
          "anyOf": [
            {
              "maxLength": 2048,
              "pattern": "^(s3|https)://\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Mezzanine file (s3:// or https://).",
          "title": "Source Uri"
        },
        "generator": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeneratorInput"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Still image rendered for a whole number of GOPs."
        },
        "kind": {
          "$ref": "#/$defs/AssetKind",
          "default": "content"
        },
        "asset_id": {
          "anyOf": [
            {
              "pattern": "^[a-z0-9][a-z0-9-]{0,47}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Defaults to asset_id_for(source).",
          "title": "Asset Id"
        },
        "content_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Catalog content id.",
          "title": "Content Id"
        },
        "cue_points_ms": {
          "default": [],
          "description": "Editorial ad cue points (ms); snapped to the nearest frame (ESAM between segment boundaries).",
          "items": {
            "type": "integer"
          },
          "title": "Cue Points Ms",
          "type": "array"
        },
        "ladder_version": {
          "description": "Ladder version, e.g. standard@0123abcd45.",
          "pattern": "^[a-z][a-z0-9-]*@[0-9a-f]{10}$",
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9_-]{1,80}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Trace id; Step Functions execution name.",
          "title": "Correlation Id"
        },
        "metadata": {
          "additionalProperties": {
            "type": "string"
          },
          "default": {},
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "ladder_version"
      ],
      "title": "IngestRequest",
      "type": "object"
    },
    "LadderFailed": {
      "description": "Provisioning a ladder failed.",
      "properties": {
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "error": {
          "title": "Error",
          "type": "string"
        },
        "cause": {
          "title": "Cause",
          "type": "string"
        }
      },
      "required": [
        "ladder_version",
        "correlation_id",
        "error",
        "cause"
      ],
      "title": "LadderFailed",
      "type": "object"
    },
    "LadderReady": {
      "description": "A ladder's job template and kit (filler, break slates, house ads, VAST) are ready.",
      "properties": {
        "ladder_version": {
          "title": "Ladder Version",
          "type": "string"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        },
        "job_template": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "MediaConvert job template name.",
          "title": "Job Template"
        }
      },
      "required": [
        "ladder_version",
        "correlation_id"
      ],
      "title": "LadderReady",
      "type": "object"
    },
    "SchedulePublished": {
      "description": "A plan was published to a channel.",
      "properties": {
        "channel": {
          "title": "Channel",
          "type": "string"
        },
        "plan_id": {
          "title": "Plan Id",
          "type": "string"
        },
        "programs": {
          "title": "Programs",
          "type": "integer"
        },
        "start_ms": {
          "title": "Start Ms",
          "type": "integer"
        },
        "end_ms": {
          "title": "End Ms",
          "type": "integer"
        },
        "correlation_id": {
          "title": "Correlation Id",
          "type": "string"
        }
      },
      "required": [
        "channel",
        "plan_id",
        "programs",
        "start_ms",
        "end_ms",
        "correlation_id"
      ],
      "title": "SchedulePublished",
      "type": "object"
    }
  }
}
