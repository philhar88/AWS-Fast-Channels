-def synthesizer():
+# Overlay O1 (FAST Channels): an optional stack-name prefix and a dedicated CDK bootstrap, from CDK context. Without
+# these context values the app synthesizes exactly as shipped.
+#   stackPrefix                stack names <stackPrefix>-pbs and <stackPrefix>-pbs-sim (construct ids unchanged)
+#   bootstrapQualifier         qualifier of a dedicated bootstrap (its cdk-<qualifier>-* roles)
+#   fileAssetsBucketName       that bootstrap's file assets bucket
+#   imageAssetsRepositoryName  that bootstrap's container assets repository
+def dedicated_bootstrap(app):
+    qualifier = app.node.try_get_context("bootstrapQualifier")
+    if not qualifier:
+        return None
+    return {
+        "qualifier": qualifier,
+        "file_assets_bucket_name": app.node.try_get_context("fileAssetsBucketName"),
+        "image_assets_repository_name": app.node.try_get_context("imageAssetsRepositoryName"),
+    }
+
+
+def synthesizer(app):
+    if dedicated := dedicated_bootstrap(app):
+        return SolutionStackSubstitions(**dedicated)
     return CDKSolution(
         cdk_json_path=Path(__file__).parent.absolute() / "cdk.json"
     ).synthesizer
