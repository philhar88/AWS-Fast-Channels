+++ b/source/infrastructure/custom_resources/waf_webacl_lambda/create_waf_webacl.py
@@ -48,12 +48,30 @@
 
     wafv2_client = boto3.client("wafv2", config=config.Config(**boto_config))
 
+    # Overlay O2 (FAST Channels): an optional customer rule group, evaluated before every guidance rule. Changing
+    # its rules (for example rotating a secret) never touches this web ACL, which on_delete removes with the lock
+    # token captured here.
+    extra_rule_group_arn = os.environ.get("EXTRA_RULE_GROUP_ARN", "")
+    customer_rules = [
+        {
+            "Name": "CustomerRuleGroup",
+            "Priority": 0,
+            "OverrideAction": {"None": {}},
+            "Statement": {"RuleGroupReferenceStatement": {"ARN": extra_rule_group_arn}},
+            "VisibilityConfig": {
+                "SampledRequestsEnabled": True,
+                "CloudWatchMetricsEnabled": True,
+                "MetricName": "CustomerRuleGroup",
+            },
+        }
+    ] if extra_rule_group_arn else []
+
